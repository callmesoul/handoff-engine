{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff.local/schemas/event.schema.json",
  "title": "HandoffEvent",
  "description": "不可变审计事件。events/<task-id>/<ulid>.json，只追加，不修改。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "task_revision",
    "attempt",
    "type",
    "actor",
    "occurred_at",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "task_id": { "type": "string", "pattern": "^ho-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{26}$" },
    "task_revision": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 0 },
    "type": { "$ref": "#/$defs/event_type" },
    "actor": { "$ref": "#/$defs/actor" },
    "occurred_at": { "$ref": "#/$defs/timestamp" },
    "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
    "from_status": {
      "oneOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }]
    },
    "to_status": {
      "oneOf": [{ "$ref": "#/$defs/status" }, { "type": "null" }]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "metadata": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "links": {
      "type": "object",
      "maxProperties": 10,
      "additionalProperties": { "type": "string", "maxLength": 2048 }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["user", "worker", "system"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$" }
      }
    },
    "status": {
      "enum": [
        "open",
        "claimed",
        "in_progress",
        "delivered",
        "awaiting_merge",
        "merged",
        "deployed",
        "verifying",
        "verified",
        "frontend_accepted",
        "failed",
        "cancelled"
      ]
    },
    "event_type": {
      "enum": [
        "task.created",
        "task.status_changed",
        "task.acceptance_amended",
        "task.cancelled",
        "task.validation_failed",
        "claim.acquired",
        "claim.heartbeat",
        "claim.expired",
        "claim.released",
        "lease.renewal_failed",
        "codex.started",
        "codex.completed",
        "codex.failed",
        "codex.timed_out",
        "gate.failed",
        "branch.pushed",
        "pr.created",
        "pr.checks_updated",
        "pr.merged",
        "deployment.started",
        "deployment.completed",
        "deployment.failed",
        "verification.started",
        "verification.check_completed",
        "verification.completed",
        "verification.retry_requested",
        "frontend.accepted",
        "admin.retry_requested",
        "admin.cancel_requested",
        "admin.lease_released",
        "admin.reverify_requested",
        "audit.correction_recorded"
      ]
    }
  }
}
