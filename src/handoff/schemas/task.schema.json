{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoff.local/schemas/task.schema.json",
  "title": "HandoffTask",
  "description": "交接仓任务单。字段含义见 doc/IMPLEMENTATION-PLAN.md 第四节。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "attempt",
    "title",
    "source",
    "target",
    "requirement",
    "scope",
    "acceptance",
    "status",
    "claim",
    "result",
    "deployment",
    "failure",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/task_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "requirement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "contract": {
      "oneOf": [
        {
          "$ref": "#/$defs/contract"
        },
        {
          "type": "null"
        }
      ]
    },
    "repro": {
      "oneOf": [
        {
          "$ref": "#/$defs/repro"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "required_secrets": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/secret_requirement"
      }
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "claim": {
      "oneOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^ho-[0-9]{8}-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "repo",
        "commit_sha"
      ],
      "properties": {
        "role": {
          "enum": [
            "frontend",
            "backend"
          ]
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "commit_sha": {
          "$ref": "#/$defs/sha"
        },
        "ref": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "repo",
        "base_ref"
      ],
      "properties": {
        "role": {
          "enum": [
            "frontend",
            "backend"
          ]
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "base_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "openapi",
            "jsonschema",
            "graphql",
            "typescript",
            "text"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^contracts/[^/]+/.+$",
          "description": "交接仓内相对路径，必须以 contracts/<task-id>/ 开头"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "store_path",
            "url",
            "repo_path"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "logs",
        "attachments"
      ],
      "properties": {
        "error": {
          "type": "string",
          "maxLength": 8000
        },
        "logs": {
          "type": "string",
          "maxLength": 20000
        },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "out_of_scope",
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "out_of_scope": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/glob"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/glob"
          }
        }
      }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "secret_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "env",
        "same_value"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "same_value": {
          "type": "boolean"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "checks"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "oneOf": [
        {
          "$ref": "#/$defs/check_http"
        },
        {
          "$ref": "#/$defs/check_openapi_diff"
        },
        {
          "$ref": "#/$defs/check_repo_script"
        },
        {
          "$ref": "#/$defs/check_test_suite"
        }
      ]
    },
    "check_http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "method",
        "url",
        "expect_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "type": {
          "const": "http"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^(\\{base_url\\}/|https?://).+$",
          "maxLength": 2048
        },
        "headers": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100000
        },
        "expect_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "expect_jsonpath": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/json_assertion"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "json_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\$.+$",
          "maxLength": 500
        },
        "equals": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "matches": {
          "type": "string",
          "maxLength": 500
        },
        "exists": {
          "type": "boolean"
        }
      }
    },
    "check_openapi_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "expected_path",
        "actual_url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "type": {
          "const": "openapi_diff"
        },
        "expected_path": {
          "type": "string",
          "pattern": "^contracts/[^/]+/.+$",
          "maxLength": 500
        },
        "actual_url": {
          "type": "string",
          "pattern": "^(\\{base_url\\}/|https?://).+$",
          "maxLength": 2048
        },
        "allow_additions": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "check_repo_script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "repo",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "type": {
          "const": "repo_script"
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "必须在 config/checks.yaml 的 repo_scripts 中注册"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "check_test_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "repo",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "type": {
          "const": "test_suite"
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "必须在 config/checks.yaml 的 test_suites 中注册"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "backward_compatible",
        "plan",
        "rollback",
        "manual_approval_required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "backward_compatible": {
          "type": "boolean"
        },
        "plan": {
          "type": "string",
          "maxLength": 8000
        },
        "rollback": {
          "type": "string",
          "maxLength": 8000
        },
        "manual_approval_required": {
          "type": "boolean"
        },
        "tool": {
          "type": "string",
          "maxLength": 100
        },
        "order": {
          "enum": [
            "before_deploy",
            "after_deploy",
            "manual"
          ],
          "description": "迁移相对部署的执行位置，由 CI 固定执行，不由 Codex 临时决定"
        },
        "scripts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "status": {
      "enum": [
        "open",
        "claimed",
        "in_progress",
        "delivered",
        "awaiting_merge",
        "merged",
        "deployed",
        "verifying",
        "verified",
        "frontend_accepted",
        "failed",
        "cancelled"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "claimed_at",
        "lease_expires_at"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "claimed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "lease_expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "heartbeat_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "started_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/check_id"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "error"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "string",
          "maxLength": 4000
        },
        "observed_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "head_sha",
        "pr_url",
        "merge_sha",
        "codex_run_id",
        "checks",
        "notes",
        "changed_paths",
        "worktree",
        "codex_thread_id"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "head_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "pr_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "merge_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "executor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "executor_session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "codex_run_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "codex_cli_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "diff_summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8000
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "checks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/check_result"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "codex_thread_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "target_sha",
        "observed_sha",
        "environment",
        "url",
        "updated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "deployed",
            "failed",
            "timeout"
          ]
        },
        "target_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "updated_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "message",
        "at"
      ],
      "properties": {
        "stage": {
          "enum": [
            "validation",
            "claim",
            "workspace",
            "codex",
            "gate",
            "push",
            "pr",
            "merge",
            "deploy",
            "verification",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "check_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "observed_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean",
          "description": "该失败是否属于「过一会儿重试就可能好」的类别（额度用尽、限流、服务端故障）。"
        },
        "retry_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ],
          "description": "计划重新入队的时刻；retryable 为 true 且未超过重试上限时才写入。"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "description": "本任务因可重试失败自动重新入队的次数。"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
