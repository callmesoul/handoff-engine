[Unit]
Description=Handoff notification outbox sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/handoff-store
Environment=HANDOFF_ROOT=%h/code/handoff-store
ExecStart=%h/code/handoff-engine/.venv/bin/handoffctl --root %h/code/handoff-store notifier
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
