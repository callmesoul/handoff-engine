# 后端 worker。只读代码 checkout + 专用交接仓 clone，两者必须分开。
#
# 安装：
#   sudo cp deploy/systemd/handoff-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now handoff-worker
#
# 代码更新只动 /opt/handoff/app，交接仓由 worker 自己 reset --hard。

[Unit]
Description=Handoff worker (Codex backend executor)
Documentation=file:/opt/handoff/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=handoff
Group=handoff
WorkingDirectory=/srv/handoff/store
EnvironmentFile=/etc/handoff/worker.env
# 使用 --listen config 时从这里读取 HANDOFF_NOTIFY_SECRET；未启用通知时文件可不存在。
EnvironmentFile=-/etc/handoff/notifier.env
Environment=PYTHONPATH=/opt/handoff/app/src
Environment=HOME=/home/handoff
ExecStart=/opt/handoff/app/.venv/bin/python -m handoff.cli --root /srv/handoff/store worker --worker backend-01 --role backend --poll-interval 15

Restart=on-failure
RestartSec=15
# Codex 会拉子进程；停止时先 TERM 整个组，给它收尾时间
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=180

# 并发上限：一个 worker 本来就串行跑 codex，留余量给 git / 测试
TasksMax=512

# 保守加固。Codex 凭据在 ~/.codex，所以不能 ProtectHome。
# 如果 Codex 报 bubblewrap 权限问题，先把 NoNewPrivileges 去掉。
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
