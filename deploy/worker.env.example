# /etc/handoff/worker.env  —— 权限 0640，属主 root:handoff
#
# 这里只放「怎么找到程序」，不放凭据。
# git 用服务账号的 SSH deploy key（~/.ssh），gh 用 `gh auth login` 写进
# ~/.config/gh，codex 用 `codex login` 写进 ~/.codex。都不要塞进环境变量：
# worker 会把 GITHUB_*/GH_*/*TOKEN* 从 Codex 子进程环境里剔掉，
# 但放在文件里更干净，也不会被误打进日志。

PATH=/usr/local/bin:/usr/bin:/bin
HANDOFF_GIT=/usr/bin/git
HANDOFF_GH=/usr/local/bin/gh
HANDOFF_CODEX=/usr/local/bin/codex

# 需要时打开，便于定位 codex 环境问题
# GIT_SSH_COMMAND=ssh -i /home/handoff/.ssh/handoff_deploy -o StrictHostKeyChecking=yes
