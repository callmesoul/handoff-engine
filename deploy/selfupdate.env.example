# 自动更新配置。复制到 /etc/handoff/selfupdate.env（后端）
# 或 ~/.config/handoff/selfupdate.env（前端），再按机器改。
#
# 只放机器专属的东西。ROLE / APP / STORE / SERVICES 里跟平台绑定的部分
# 交给 unit 里的 Environment= 更好，这里只放需要按机器调的。

# 分支。交接仓默认 main
BRANCH=main

# 后端：worker 正在跑 codex 时最多推迟几小时。超过就强制重启，宁可丢一轮 attempt。
# 设太大，代码更新会被一个长任务堵到天黑；设太小，等于没有推迟。
DEFER_MAX=6

# 解释器。留空则自动找 APP/.venv/bin/python（Windows: .venv-win\Scripts\python.exe）
# PY=/opt/handoff/app/.venv/bin/python

# 手动强制更新一次（跳过 in_progress 检查）。平时不要留在文件里。
# FORCE=1
