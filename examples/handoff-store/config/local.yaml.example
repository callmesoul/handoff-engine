# 复制为 local.yaml；该文件被 .gitignore 排除。
repo_paths:
  your-org/web: /home/you/code/web
  your-org/api: /home/you/code/api

repositories:
  your-org/api:
    remote: git@github.com:your-org/api.git
    cache_dir: .handoff-run/repo-cache/your-org__api

environments:
  dev:
    url: https://api.dev.example.com

codex:
  binary: /usr/local/bin/codex
  timeout_seconds: 3600

# 恢复原前端会话时可按执行器强制切换模型；省略或 null 会保留会话/宿主默认模型。
notifications:
  restore_models:
    codex: null
    dsh: null
    # dsh:
    #   provider: deepseek-account
    #   model: deepseek-chat

admin:
  database: .handoff-run/index/handoff.sqlite3

# secrets:
#   HANDOFF_NOTIFY_SECRET_FILE: /etc/handoff/notify-secret
#   OPENAPI_API_KEY_FILE: /etc/handoff/openapi-api-key
